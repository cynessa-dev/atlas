---
import SectionIntro from '../ui/SectionIntro.astro';
---

<section class="section-padding">
    <div class="w-full min-h-screen flex flex-col justify-center items-center">
        <h2 class="eyebrow">[ ABOUT ME ]</h2>
        <div>
            <h1
                class="text-4xl text-justify font-extrabold leading-none tracking-wide"
            >
                <span class="block">SHIP SMALL,</span>
                <span class="block">DELIVER BIG.</span>
            </h1>
        </div>
    </div>
    <div>
        <SectionIntro>
            I'm an aspiring software engineer who moves with purpose, builds
            thoughtfully, and focuses on connecting with people. No fluff, no
            bloat. Just software that works. My work is simple: Coffee on the
            left, code on the right. I ship while it's still hot.
        </SectionIntro>
    </div>
</section>
