---

type bootMessage = {
    message: string,
    loading?: boolean,
    seconds?: number,
};

const bootMessages: bootMessage[] = [
    { message: 'POST initiated' },
    { message: 'CPU detected' },
    { message: 'Memory test', loading: true, seconds: 2.0 },
    { message: 'Brewing coffee', loading: true, seconds: 3.0 },
    { message: 'Boot device: COOL_PORTFOLIO' },
    { message: 'Loading kernel: ChanOS', loading: true, seconds: 2.0 },
    { message: 'Initializing interface' },
    { message: 'READY' },
    { message: 'Booting MamplaTech', loading: true, seconds: 3.0 },
]

---

<section id="hero" class="relative flex items-center min-h-screen overflow-hidden">
    <div id="props" class="absolute w-full h-full origin-[50%_50%]">
        <div id="laptop" class="absolute top-1/2 left-1/2 -translate-1/2 px-6 py-4 w-240 h-160 bg-gray-600">
            <div id="kernel" class="hidden justify-center items-center w-full h-full">
                <h1 class="text-zinc-200 text-8xl font-black">ChanOS</h1>
            </div>
            <div class="jetbrains-mono-400 text-zinc-200">
                {bootMessages.map((boot) => (
                    <p 
                        data-boot-message
                        data-boot-loading={boot.loading ?? false}
                        data-boot-seconds={boot.seconds ?? 1.0}
                    >
                        {boot.message}
                    </p>
                ))}
            </div>
        </div>
    </div>
    <div id="contents">

    </div>
</section>

<script>
    import { initHero } from '../scripts/hero';

    initHero();
</script>