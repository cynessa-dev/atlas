            />
        </div>
        <div class="flex-1 text-xs">
            <h1 class="text-center">Hello, World</h1>
        </div>
        <div class="flex justify-center items-center shrink-0 size-8">
            <img 
                src={brandLogo.src}
                alt="Christian Mamplata"
                class="w-full h-full object-contain"
            />
        </div>
    </div>
</nav>

<style>
    * { outline: 1px solid red; }
</style>