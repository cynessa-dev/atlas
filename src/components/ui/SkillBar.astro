---
interface Skill {
	name: string;
	icon: string;
}

interface Props {
	skills: Skill[];
}

const { skills } = Astro.props;
---

<div
	class="flex justify-center items-center px-4 w-full"
>
	<div class="flex px-6 py-4 space-x-8 bg-slate-100 rounded-sm shadow-[0_6px_8px_-4px] shadow-slate-600/20">
		{skills.map((skill) => (
			<div>
				{skill.name}
			</div>
		))}
	</div>
</div>
