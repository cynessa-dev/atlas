---

type NavItem = {
    name: string,
    href: string
};

const items: NavItem[] = [
    { name: 'HOME', href: '#hero' },
    { name: 'MINDSET', href: '#mission' },
    { name: 'ABOUT', href: '#about' },
    { name: 'SKILLS', href: '#skills' },
    { name: 'PROJECTS', href: '#projects' },
    { name: 'CONNECT', href: '#connect' },
];

---

<div class="fixed bottom-0 flex justify-between items-center px-8 py-6 w-full">
    <ul class="flex items-start gap-x-16 text-sm font-light tracking-wider">
        {items.map((item) => (
            <li class="px-4 py-2 text-center rounded-full shadow-sm cursor-pointer hover:scale-110 transition-transform duration-300">
                <a href={item.href} target="_self">./{item.name}</a>
            </li>
        ))}
    </ul>
    <div>
        <button class="active inline-flex justify-center items-center size-12 rounded-full shadow-sm cursor-pointer hover:scale-110 transition-transform duration-300" data-menu-toggle>
            <span id="menu-icon" class="material-symbols-rounded">menu</span>
        </button>
    </div>
</div>

<script>
    import { initMenu } from '../../scripts/menu';

    initMenu();
</script>