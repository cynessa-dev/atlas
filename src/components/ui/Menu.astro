---

type NavItem = {
    name: string,
    href: string
};

const items: NavItem[] = [
    { name: 'HOME', href: '#hero' },
    { name: 'MINDSET', href: '#mission' },
    { name: 'ABOUT', href: '#about' },
    { name: 'SKILLS', href: '#skills' },
    { name: 'PROJECTS', href: '#projects' },
    { name: 'CONNECT', href: '#connect' },
];

---

<div 
    class="
        fixed
        z-50
        bottom-0
        w-full 
        flex 
        flex-col-reverse
        justify-between 
        items-end
        gap-y-4
        px-8
        py-6
        md:flex-row-reverse
        md:items-center
        md:gap-y-0
">
    <div data-menu-toggle-wrapper>
        <button
            type="button"
            class="
                inline-flex 
                size-12
                items-center 
                justify-center  
                rounded-full 
                shadow-sm 
                cursor-pointer  
                transition-transform 
                duration-300
                hover:scale-110
                disabled:hover:scale-100
                disabled:cursor-not-allowed
                disabled:opacity-50
            " 
            aria-controls="main-menu"
            aria-expanded="false"
            data-menu-toggle
        >
            <span id="menu-icon" class="material-symbols-rounded">menu</span>
        </button>
    </div>
    <ul
        id="main-menu"
        class="
            flex 
            flex-col 
            items-end
            gap-y-4
            text-sm
            font-light 
            tracking-wider
            md:flex-row 
            md:items-start
            md:gap-x-4
            md:gap-y-0
            lg:gap-x-8
            xl:gap-x-16 
    ">
        {items.map((item) => (
            <li data-menu-item>
                <a 
                    href={item.href} 
                    class="
                        inline-block
                        px-4 
                        py-2
                        bg-slate-200
                        text-center 
                        rounded-full
                        shadow-sm 
                        cursor-pointer 
                        hover:scale-110 
                        transition-transform 
                        duration-300
                ">
                    ./{item.name}
                </a>
            </li>
        ))}
    </ul>
</div>